{
  "name": "fairguest",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Vlad Humenny",
    "email": "hello@khlumen.com"
  },
  "homepage": "https://github.com/vladIDH/openstay#readme",
  "bugs": {
    "url": "https://github.com/vladIDH/openstay/issues"
  },
  "description": "Guest registration for short-term rentals, on the host's computer: the data Spain's Real Decreto 933/2021 asks for, deadlines, retention, field encryption, and the Mossos d'Esquadra file for Catalonia. No network, no files.",
  "keywords": [
    "guest-registration",
    "short-term-rental",
    "vacation-rental",
    "ses-hospedajes",
    "mossos",
    "rd-933-2021"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladIDH/openstay.git",
    "directory": "packages/fairguest"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build"
  }
}
