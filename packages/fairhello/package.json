{
  "name": "fairhello",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Vlad Humenny",
    "email": "hello@khlumen.com"
  },
  "homepage": "https://github.com/vladIDH/openstay#readme",
  "bugs": {
    "url": "https://github.com/vladIDH/openstay/issues"
  },
  "description": "Draft replies to guests of short-term rentals, on the host's computer: the house file, the prompt, the checks before sending (fresh, no prices, access codes only during the stay). No network, no files, no dependencies.",
  "keywords": [
    "short-term-rental",
    "vacation-rental",
    "guest-messages",
    "smoobu",
    "beds24"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladIDH/openstay.git",
    "directory": "packages/fairhello"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build"
  }
}
